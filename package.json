{
  "name": "navyix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @navyix/web --filter @navyix/api dev",
    "build": "pnpm --filter @navyix/policy build && pnpm --filter @navyix/api build && pnpm --filter @navyix/web build",
    "typecheck": "pnpm --filter @navyix/policy typecheck && pnpm --filter @navyix/api typecheck && pnpm --filter @navyix/web typecheck",
    "lint": "pnpm --filter @navyix/web lint && pnpm --filter @navyix/api lint",
    "test": "node --test packages/policy/test/*.test.mjs packages/workflow/test/*.test.mjs packages/server/test/*.test.mjs packages/browser-session/test/*.test.mjs",
    "test:workflow": "node --test packages/workflow/test/*.test.mjs",
    "test:server": "node --test packages/server/test/*.test.mjs",
    "preview:workflow": "node scripts/preview-workflow.mjs",
    "sync:workbench": "node scripts/sync-workbench.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:browser:integration": "node scripts/test-browser.mjs --integration",
    "verify": "node scripts/verify-workspace.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
