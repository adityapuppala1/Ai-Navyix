# Copy into apps/web/.env.local. Never use NEXT_PUBLIC_ for these values.
NAVYIX_BROWSER_ENABLED=false
NAVYIX_PUBLIC_ORIGIN=https://navyix.example.com
NAVYIX_API_ORIGIN=https://api.navyix.example.com
# Dedicated login; never use the API/migration/admin database identity.
NAVYIX_SESSION_DATABASE_URL=postgresql://navyix_browser:REPLACE@database.example.com:5432/navyix?sslmode=verify-full
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NAVYIX_SESSION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
OIDC_ISSUER=https://identity.example.com
OIDC_JWKS_URL=https://identity.example.com/jwks
OIDC_CLIENT_ID=REPLACE
OIDC_TOKEN_PROFILE=jwt-access
OIDC_AUDIENCE=navyix-api
OIDC_REQUIRED_SCOPE=navyix/workflow
NAVYIX_OIDC_AUTHORIZATION_URL=https://identity.example.com/authorize
NAVYIX_OIDC_TOKEN_URL=https://identity.example.com/token
NAVYIX_OIDC_CLIENT_AUTH=client_secret_basic
NAVYIX_OIDC_CLIENT_SECRET=REPLACE
# Only local HTTP public/API origins are permitted with NODE_ENV != production.
NAVYIX_ALLOW_HTTP_LOOPBACK=false
