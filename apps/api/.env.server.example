# Merge into root .env locally. Do not commit actual credentials.
NAVYIX_API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=4000
# Separate runtime/migration identities; supply fresh secrets outside Git.
DATABASE_URL=postgresql://navyix_app:REPLACE@127.0.0.1:5432/navyix?schema=public
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:REPLACE@127.0.0.1:5432/navyix?schema=public
OIDC_TOKEN_PROFILE=jwt-access
OIDC_ISSUER=https://YOUR_ISSUER
OIDC_JWKS_URL=https://YOUR_ISSUER/.well-known/jwks.json
OIDC_AUDIENCE=navyix-api
OIDC_REQUIRED_SCOPE=navyix/api
# For Cognito set OIDC_TOKEN_PROFILE=cognito-access and your real app-client ID.
OIDC_CLIENT_ID=
# No role, user ID, tenant ID, or auth-bypass environment variable exists.
