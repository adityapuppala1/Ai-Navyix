{
  "name": "@navyix/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate:dev": "node scripts/prisma.mjs migrate dev",
    "db:migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:validate": "node scripts/prisma.mjs validate",
    "org:bootstrap": "node --env-file=../../.env scripts/bootstrap-organization.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@prisma/client": "^6.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@navyix/server": "workspace:*",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "eslint": "^9.19.0",
    "prisma": "^6.3.1",
    "typescript": "^5.7.3",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
